# رابط اتصال قاعدة بيانات PostgreSQL
# مثال محلي:  postgresql://postgres:postgres@127.0.0.1:5432/app_db
# مثال Neon:  postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# رمز دخول لوحة تحكم المدرب (/coach) — غيّره قبل التدشين
COACH_PIN=2025
